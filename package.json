{
  "name": "backend-questionnaire-allergie",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ./node_modules/prisma/build/index.js generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "prestart": "node ./node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
